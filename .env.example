# Environment variables for Docker Compose
# Copy this file to .env and fill in your values

# App settings
APP_NAME=ARIP
DEBUG=false

# Database
POSTGRES_USER=arip
POSTGRES_PASSWORD=12345678
POSTGRES_DB=arip_db
POSTGRES_PORT=5432

# LLM settings
# Provider: openai, groq, gemini, openrouter, ollama
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here

# Models (optional - uses provider-specific defaults if not set)
# See backend/app/services/llm_service/client.py PROVIDER_DEFAULTS
LLM_MODEL=
CHATBOT_MODEL=

# Ollama only
LLM_BASE_URL=

# Rate limiting (for async LLM clients)
LLM_RATE_LIMIT_RPM=60
LLM_MAX_RETRIES=3

# Trusted proxies for X-Forwarded-For header (comma-separated)
TRUSTED_PROXIES=127.0.0.1

# Auth settings
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
