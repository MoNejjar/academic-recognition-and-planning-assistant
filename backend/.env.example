# ===========================================
# ARIP Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# -------------------------------------------
# LLM Settings
# -------------------------------------------
# Provider: openai, groq, gemini, openrouter, ollama
LLM_PROVIDER=openai

# API key for the selected provider
# Groq: https://console.groq.com/keys
# OpenAI: https://platform.openai.com/api-keys
# OpenRouter: https://openrouter.ai/keys
LLM_API_KEY=

# Models (optional - smart defaults based on provider)
# If not set, uses provider-specific defaults:
#   openai:     LLM_MODEL=gpt-4o,           CHATBOT_MODEL=gpt-4o-mini
#   groq:       LLM_MODEL=llama-3.2-90b-vision-preview, CHATBOT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   ollama:     LLM_MODEL=llava,            CHATBOT_MODEL=llama3
# LLM_MODEL=gpt-4o           # For PDF extraction (vision-capable)
# CHATBOT_MODEL=gpt-4o-mini  # For chatbot

# Base URL for Ollama (only needed if using ollama provider)
# LLM_BASE_URL=http://localhost:11434

# -------------------------------------------
# Application Settings
# -------------------------------------------
# Environment: development | production
# In production, dotenv is not loaded automatically
ENVIRONMENT=development

# Debug mode (optional)
DEBUG=false

# Secret key for session signing (optional)
SECRET_KEY=your-secret-key-here

# -------------------------------------------
# Security
# -------------------------------------------
# Trusted proxy IPs for X-Forwarded-For header (comma-separated)
# Default: 127.0.0.1
TRUSTED_PROXIES=127.0.0.1

# -------------------------------------------
# Database
# -------------------------------------------
# SQLite is used by default (no configuration needed)
# For PostgreSQL, uncomment and configure:
# DATABASE_URL=postgresql://user:password@localhost:5432/arip
